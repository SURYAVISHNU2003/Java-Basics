package practice_java;

class Vehicle {
	String brand;
	int year;
	
	void startEngine() {
		System.out.println("Engine");
	}
}
class Car extends Vehicle{
	String fueltype;
	
void startEngine() {
		System.out.println("Car engine starts");
	}
void drive() {
	System.out.println("Car is Driving");
}
	
}
class Truck extends Vehicle{
	int loadcapacity;
	
	void startEngine() {
		System.out.println("Truck engine starts");
	}
	void haul() {
		System.out.println("Truck id hauling");
	}
	
}



public class demo {
	public static void main(String []args) {
	Car c1=new Car();
	c1.brand="BMW";
	c1.year=2016;
	c1.fueltype="Petrol";
	c1.startEngine();
	c1.drive();
	
	Truck t1=new Truck();
	t1.brand="Tata";
	t1.year=2020;
	t1.loadcapacity=3;
	t1.startEngine();
	t1.haul();
	
	}
}
