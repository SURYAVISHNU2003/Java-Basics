package student;
import java.util.*;
public class palindrome {
	
	static Scanner sc=new Scanner(System.in);
	
	public static boolean Palindrome(int n) {
		int temp=n;
		int rev=0;
		while(n>0) {
		int rem=n%10;
		rev=(rev*10)+rem;
		n=n/10;
		}
		if(temp==rev) {
			return true;
		}
		else {
			return false;
		}
		
	}
	public static void main(String[] args) {
		int n=sc.nextInt();
		System.out.println(Palindrome(n));
	}

}
}
