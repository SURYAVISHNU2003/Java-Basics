package Surya;
import java.util.*;

public class Excep {

	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int a=sc.nextInt();
		int b=sc.nextInt();
		int c=0;
		try {
			
			 c=a/b;
			
		}
		catch(ArithmeticException e) {
			System.out.println(e);
		}
		System.out.println(c);
		

	}

}
