import java.util.*;
class find{
    void evenorodd(int num){
        if(num%2!=0){
            System.out.println("odd");
        }
        else{
            System.out.println("Even");
        }  
    }

    public static void main(String args[]){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        find obj=new find();
        obj.evenorodd(n);

    }
}
