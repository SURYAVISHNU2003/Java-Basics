package Surya;
import java.util.*;


public class Excep {

	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		
		int a=0;
		int b=0;
		int c=0;
		
		try {
		 a=sc.nextInt();
		 b=sc.nextInt();
		 c=a/b;	
		}
		
		catch(ArithmeticException e) {
			System.out.println(e);
		}
		catch(InputMismatchException e) {
			System.out.println(e);
		}
		System.out.println(c);
		
	}

}
